    local grayBtn = createButton(envSubContainer, "🖤 灰度 [关闭]", UDim2.new(1,0,0,36), nil, Color3.fromRGB(55,55,70))
    grayBtn.LayoutOrder = 6
    grayBtn.MouseButton1Click:Connect(function()
        grayscaleEnabled = not grayscaleEnabled
        grayBtn.Text = grayscaleEnabled and "🖤 灰度 [开启]" or "🖤 灰度 [关闭]"
        grayBtn.BackgroundColor3 = grayscaleEnabled and Color3.fromRGB(40,180,80) or Color3.fromRGB(55,55,70)
        if grayscaleEnabled then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and not obj:IsDescendantOf(LocalPlayer.Character) then
                    savedColors[obj] = obj.Color
                    obj.Color = Color3.fromRGB(128,128,128)
                end
            end
        else
            for obj, c in pairs(savedColors) do
                if obj and obj.Parent then obj.Color = c end
            end
            savedColors = {}
        end
    end)
    
    -- 重置环境
    local resetEnvBtn = createButton(envSubContainer, "🔄 重置环境", UDim2.new(1,0,0,36), nil, Color3.fromRGB(180,80,40))
    resetEnvBtn.LayoutOrder = 7
    resetEnvBtn.MouseButton1Click:Connect(function()
        -- X-Ray
        if xrayEnabled then
            xrayEnabled = false
            xrayBtn.Text = "👁️ X-Ray [关闭]"
            xrayBtn.BackgroundColor3 = Color3.fromRGB(55,55,70)
            for obj, t in pairs(savedTransparencies) do
                if obj and obj.Parent then obj.Transparency = t end
            end
            savedTransparencies = {}
        end
        -- Fog
        if fogDisabled then
            fogDisabled = false
            fogBtn.Text = "🌫️ 雾气 [开启]"
            fogBtn.BackgroundColor3 = Color3.fromRGB(55,55,70)
            Lighting.FogEnd = originalFogEnd
        end
        -- Brightness
        Lighting.Brightness = originalBrightness
        brightBox.Text = tostring(originalBrightness)
        -- Grayscale
        if grayscaleEnabled then
            grayscaleEnabled = false
            grayBtn.Text = "🖤 灰度 [关闭]"
            grayBtn.BackgroundColor3 = Color3.fromRGB(55,55,70)
            for obj, c in pairs(savedColors) do
                if obj and obj.Parent then obj.Color = c end
            end
            savedColors = {}
        end
        warn("KING: 环境已重置为默认状态")
    end)
    
    -- 6. 高危
    local dangerBtn = createButton(scrollFrame, "⚠️ 高危", UDim2.new(1,-20,0,44), nil, Color3.fromRGB(180,40,40))
    dangerBtn.LayoutOrder = order; order = order + 1
    
    local dangerSubContainer = Instance.new("Frame")
    dangerSubContainer.Size = UDim2.new(1,-20,0,0)
    dangerSubContainer.BackgroundTransparency = 1
    dangerSubContainer.ClipsDescendants = true
    dangerSubContainer.LayoutOrder = order; order = order + 1
    dangerSubContainer.Parent = scrollFrame
    
    local dangerSubList = Instance.new("UIListLayout")
    dangerSubList.SortOrder = Enum.SortOrder.LayoutOrder
    dangerSubList.Padding = UDim.new(0,4)
    dangerSubList.Parent = dangerSubContainer
    
    local dangerOpen = false
    dangerBtn.MouseButton1Click:Connect(function()
        dangerOpen = not dangerOpen
        TweenService:Create(dangerSubContainer, TweenInfo.new(0.2), {Size = UDim2.new(1,-20,0, dangerOpen and 300 or 0)}):Play()
        if dangerOpen then refreshPlayerList() end
    end)
    
    -- 警告文字
    local warnLabel = createLabel(dangerSubContainer, "⚠️ 高风险！极易封号！", UDim2.new(1,0,0,24), nil, 14, Enum.Font.GothamBold, Color3.fromRGB(255,80,80), Enum.TextXAlignment.Center)
    warnLabel.LayoutOrder = 1
    
    local dangerBackBtn = createButton(dangerSubContainer, "← 返回", UDim2.new(1,0,0,36), nil, Color3.fromRGB(80,80,100))
    dangerBackBtn.LayoutOrder = 2
    dangerBackBtn.MouseButton1Click:Connect(function()
        dangerOpen = false
        TweenService:Create(dangerSubContainer, TweenInfo.new(0.2), {Size = UDim2.new(1,-20,0,0)}):Play()
    end)
    
    -- 玩家列表容器
    local playerListFrame = Instance.new("Frame")
    playerListFrame.Size = UDim2.new(1,0,1,-80)
    playerListFrame.Position = UDim2.new(0,0,0,60)
    playerListFrame.BackgroundTransparency = 1
    playerListFrame.Parent = dangerSubContainer
    
    local playerListLayout = Instance.new("UIListLayout")
    playerListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    playerListLayout.Padding = UDim.new(0,3)
    playerListLayout.Parent = playerListFrame
    
    local selectedTarget = nil
    
    function refreshPlayerList()
        for _, child in pairs(playerListFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        selectedTarget = nil
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local pBtn = createButton(playerListFrame, p.Name, UDim2.new(1,0,0,30), nil, Color3.fromRGB(60,60,80))
                pBtn.LayoutOrder = _
                pBtn.MouseButton1Click:Connect(function()
                    -- 取消之前选中
                    for _, pb in pairs(playerListFrame:GetChildren()) do
                        if pb:IsA("TextButton") then pb.BackgroundColor3 = Color3.fromRGB(60,60,80) end
                    end
                    pBtn.BackgroundColor3 = Color3.fromRGB(40,180,80)
                    selectedTarget = p
                end)
            end
        end
    end
    
    -- 甩飞按钮
    local launchBtn = createButton(dangerSubContainer, "💥 甩飞目标", UDim2.new(1,0,0,36), nil, Color3.fromRGB(200,40,40))
    launchBtn.LayoutOrder = 99
    launchBtn.MouseButton1Click:Connect(function()
        if not selectedTarget or not selectedTarget.Character then
            warn("KING: 未选择有效目标！")
            return
        end
        local targetChar = selectedTarget.Character
        local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
        local myChar = LocalPlayer.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        
        if not targetHRP or not myHRP then
            warn("KING: 目标或自身HRP不存在！")
            return
        end
        
        local originalCFrame = myHRP.CFrame
        myHRP.CFrame = targetHRP.CFrame * CFrame.new(0,0,3)
        
        -- 高频碰撞 0.5秒
        local startTime = tick()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if tick() - startTime > 0.5 or not targetHRP or not targetHRP.Parent then
                conn:Disconnect()
                if myHRP and myHRP.Parent then
                    myHRP.CFrame = originalCFrame
                end
                warn("KING: 甩飞完成，已返回原位")
                return
            end
            if myHRP and myHRP.Parent and targetHRP and targetHRP.Parent then
                myHRP.CFrame = targetHRP.CFrame * CFrame.new(math.random(-1,1)*0.1, math.random(-1,1)*0.1, math.random(-1,1)*0.1)
            end
        end)
    end)
    
    -- 7. 敬请期待
    local soonBtn = createButton(scrollFrame, "✨ 敬请期待", UDim2.new(1,-20,0,44), nil, Color3.fromRGB(80,70,100))
    soonBtn.LayoutOrder = order; order = order + 1
    soonBtn.TextColor3 = Color3.fromRGB(180,180,200)
    soonBtn.Font = Enum.Font.GothamItalic
    soonBtn.MouseButton1Click:Connect(function()
        warn("KING: 新功能开发中，敬请期待！")
    end)
    
    -- ===== 拖动主面板 =====
    makeDraggable(mainPanel)
    
    -- ===== K 按钮（左下角）=====
    local kButton = createFrame(gui, UDim2.new(0,40,0,40), UDim2.new(0,20,1,-60), Color3.fromRGB(50,50,70), 0, 20)
    kButton.ZIndex = 100
    local kLabel = createLabel(kButton, "K", UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), 20, Enum.Font.GothamBlack, Color3.white, Enum.TextXAlignment.Center)
    
    local mainVisible = true
    
    kButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 
           or input.UserInputType == Enum.UserInputType.Touch then
            -- 短按切换显隐（拖动由makeDraggable处理）
            local startTime = tick()
            local endedConn
            endedConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    endedConn:Disconnect()
                    if tick() - startTime < 0.3 then
                        mainVisible = not mainVisible
                        mainPanel.Visible = mainVisible
                    end
                end
            end)
        end
    end)
    
    makeDraggable(kButton)
    
    -- ===== 入场动画 =====
    mainPanel.Visible = true
    mainPanel.Size = UDim2.new(0,0,0,0)
    mainPanel.BackgroundTransparency = 1
    kButton.BackgroundTransparency = 1
    
    TweenService:Create(mainPanel, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0,240,0,400),
        BackgroundTransparency = 0
    }):Play()
    
    wait(0.3)
    TweenService:Create(kButton, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0
    }):Play()
    
    -- ===== 核心循环 =====
    spawn(function()
        while gui and gui.Parent do
            wait(0.05)
            
            -- ESP
            if espEnabled then
                local cam = workspace.CurrentCamera
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local screenPos, onScreen = cam:WorldToScreenPoint(hrp.Position)
                            if onScreen then
                                if not espMarkers[p.UserId] then
                                    local marker = Instance.new("Frame")
                                    marker.Size = UDim2.new(0,6,0,6)
                                    marker.BackgroundColor3 = Color3.fromRGB(0,255,255)
                                    marker.BorderSizePixel = 0
                                    marker.ZIndex = 50
                                    marker.Parent = gui
                                    local mc = Instance.new("UICorner")
                                    mc.CornerRadius = UDim.new(1,0)
                                    mc.Parent = marker
                                    espMarkers[p.UserId] = marker
                                end
                                espMarkers[p.UserId].Position = UDim2.new(0, screenPos.X - 3, 0, screenPos.Y - 3)
                            else
                                if espMarkers[p.UserId] then
                                    espMarkers[p.UserId]:Destroy()
                                    espMarkers[p.UserId] = nil
                                end
                            end
                        end
                    end
                end
                -- 清理离线玩家标记
                for uid, marker in pairs(espMarkers) do
                    local found = false
                    for _, p in pairs(Players:GetPlayers()) do
                        if p.UserId == uid then found = true; break end
                    end
                    if not found then
                        safeDestroy(marker)
                        espMarkers[uid] = nil
                    end
                end
            end
            
            -- Aim Assist
            if aimAssistEnabled then
                local cam = workspace.CurrentCamera
                local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
                local closestDist = 100
                local closestHRP = nil
                
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local sp, onScreen = cam:WorldToScreenPoint(hrp.Position)
                            if onScreen then
                                local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                if dist < closestDist then
                                    closestDist = dist
                                    closestHRP = hrp
                                end
                            end
                        end
                    end
                end
                
                if closestHRP then
                    local lookCF = CFrame.lookAt(cam.CFrame.Position, closestHRP.Position)
                    cam.CFrame = cam.CFrame:Lerp(lookCF, 0.1)
                end
            end
            
            -- Fly
            if flyEnabled then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if rising then
                        hrp.Velocity = Vector3.new(0, flySpeed, 0)
                    elseif descending then
                        hrp.Velocity = Vector3.new(0, -flySpeed, 0)
                    else
                        hrp.Velocity = Vector3.new(0, 0, 0)
                    end
                end
            end
            
            -- Infinite Jump
            if infJumpEnabled then
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.FloorMaterial ~= Enum.Material.Air then
                    hum.JumpPower = jumpPower
                    hum.Jump = true
                end
            end
            
            -- WalkSpeed sync
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.WalkSpeed ~= walkSpeedValue and not flyEnabled then
                hum.WalkSpeed = walkSpeedValue
            end
        end
    end)
end
