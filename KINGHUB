-- ========== 工具函数 ==========
local function verifyKey(key)
    for _, v in ipairs(VALID_KEYS) do
        if key == v then return true end
    end
    return false
end

local function safeDestroy(obj)
    if obj and obj.Parent then obj:Destroy() end
end

local function clampToScreen(frame, padding)
    padding = padding or 0
    local vp = workspace.CurrentCamera.ViewportSize
    local pos = frame.Position
    local size = frame.Size
    
    local minX = padding
    local minY = padding
    local maxX = vp.X - size.Width.Value - padding
    local maxY = vp.Y - size.Height.Value - padding
    
    local newX = math.clamp(pos.X.Value, minX, maxX)
    local newY = math.clamp(pos.Y.Value, minY, maxY)
    
    frame.Position = UDim2.new(0, newX, 0, newY)
end

-- ========== 拖动系统 ==========
local function makeDraggable(frame, handle)
    handle = handle or frame
    local dragging = false
    local dragStart, startPos
    
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 
           or input.UserInputType == Enum.UserInputType.Touch then
            dragStart = input.Position
            startPos = frame.Position
            -- 延迟判断是否为拖动（>0.3秒才算拖动）
            local holdTime = 0
            local holdConn
            holdConn = RunService.RenderStepped:Connect(function(dt)
                holdTime = holdTime + dt
                if holdTime >= 0.3 then
                    dragging = true
                    holdConn:Disconnect()
                end
            end)
            
            local endedConn
            endedConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    holdConn:Disconnect()
                    endedConn:Disconnect()
                end
            end)
        end
    end)
    
    handle.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement 
           or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
            clampToScreen(frame, 0)
        end
    end)
end

-- ========== 创建 UI 辅助 ==========
local function createFrame(parent, size, position, color, transparency, cornerRadius)
    local f = Instance.new("Frame")
    f.Size = size
    f.Position = position or UDim2.new(0,0,0,0)
    f.BackgroundColor3 = color or Color3.fromRGB(40,40,50)
    f.BackgroundTransparency = transparency or 0
    f.BorderSizePixel = 0
    f.Parent = parent
    if cornerRadius then
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, cornerRadius)
        c.Parent = f
    end
    return f
end

local function createLabel(parent, text, size, position, fontSize, font, color, align)
    local l = Instance.new("TextLabel")
    l.Text = text
    l.Size = size or UDim2.new(1,0,0,30)
    l.Position = position or UDim2.new(0,0,0,0)
    l.Font = font or Enum.Font.Gotham
    l.TextSize = fontSize or 16
    l.TextColor3 = color or Color3.white
    l.BackgroundTransparency = 1
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

local function createButton(parent, text, size, position, bgColor, textColor)
    local b = Instance.new("TextButton")
    b.Text = text
    b.Size = size or UDim2.new(1,-20,0,44)
    b.Position = position or UDim2.new(0,10,0,0)
    b.BackgroundColor3 = bgColor or Color3.fromRGB(55,55,70)
    b.TextColor3 = textColor or Color3.white
    b.Font = Enum.Font.GothamBold
    b.TextSize = 16
    b.BorderSizePixel = 0
    b.AutoButtonColor = true
    b.Parent = parent
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0,8)
    c.Parent = b
    return b
end

